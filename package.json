{
  "name": "moddock",
  "version": "1.0.0-beta.0",
  "displayVersion": "1.0.0b",
  "description": "Safety-first CLI/TUI for transactional local mod management and experimental runtime compatibility",
  "type": "module",
  "bin": {
    "moddock": "dist/moddock.js"
  },
  "files": [
    "dist/moddock.js",
    "README.md",
    "COMMANDS.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "native/include/modedock_plugin.h",
    "native/bin/moddock-native-probe.exe",
    "managed/bin/managed-inspector/**",
    "managed/bin/runtime/**",
    "docs/NATIVE_ABI.md",
    "docs/RUNTIME_ARCHITECTURE.md",
    "docs/BEPINEX_COMPATIBILITY.md",
    "docs/HARMONY_COMPATIBILITY.md",
    "docs/GAME_ADAPTERS.md",
    "docs/ARCHITECTURE.md",
    "docs/ADAPTERS.md",
    "docs/PUBLISHING.md",
    "docs/RELEASE_1.0.0b.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:managed": "node scripts/build-managed.mjs",
    "build:all": "npm run build:native && npm run build:managed && npm run build",
    "dev": "npm run build && node dist/moddock.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:tui": "node scripts/test-interactive.mjs",
    "test:install": "node scripts/test-global-install.mjs",
    "verify:release": "npm run build:all && npm run verify && npm run test:install",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:tui",
    "prepack": "npm run verify"
  },
  "keywords": [
    "mods",
    "plugins",
    "mod-manager",
    "game-mods",
    "cli",
    "terminal",
    "dll",
    "bepinex",
    "harmony"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "typescript": "^5.9.0"
  }
}

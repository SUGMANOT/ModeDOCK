{
  "name": "@modedock/core",
  "version": "0.1.0",
  "description": "Safety-first package and profile engine for game mod launchers, private registries, and server panels",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "moddock-core": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./publisher": {
      "types": "./dist/publisher/index.d.ts",
      "import": "./dist/publisher/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','dist-test'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:coverage": "npm run build && node scripts/run-tests.mjs --coverage",
    "verify": "npm run typecheck && npm test",
    "prepack": "npm run verify"
  },
  "keywords": [
    "mods",
    "mod-manager",
    "package-manager",
    "game-launcher",
    "modpack",
    "transaction",
    "rollback"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SUGMANOT/ModeDOCK.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}

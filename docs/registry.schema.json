{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modedock.dev/schemas/registry-v1.json",
  "title": "ModeDOCK static registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor"],
          "properties": {
            "descriptor": { "type": "string", "minLength": 1 },
            "integrity": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SUGMANOT/ModeDOCK/blob/main/docs/challenge.schema.json",
  "title": "ModeDOCK Challenge Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "game", "environment", "brief"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "homepage": { "type": "string" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "audience": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["player", "streamer", "creator", "launcher"] }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
        "version": { "type": "string" },
        "loader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
            "version": { "type": "string" }
          }
        },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "architectures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "packages"],
      "properties": {
        "mode": { "enum": ["overlay", "exact"] },
        "packages": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "difficulty": { "enum": ["casual", "standard", "hard", "extreme"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireStableEnvironment": { "type": "boolean" },
        "watch": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "not": { "const": "." } },
              "capture": { "enum": ["hash", "copy"] },
              "required": { "type": "boolean" },
              "maxBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "type"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
              "label": { "type": "string", "minLength": 1 },
              "type": { "enum": ["string", "number", "boolean"] },
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "instructions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "consumerData": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modedock.dev/schemas/package-v1.json",
  "title": "ModeDOCK package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "game", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "homepage": { "type": "string" },
    "license": { "type": "string" },
    "scope": { "enum": ["client", "server", "both"] },
    "game": { "$ref": "#/$defs/compatibility" },
    "loader": { "$ref": "#/$defs/compatibility" },
    "platforms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "architectures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "optionalDependencies": { "$ref": "#/$defs/dependencies" },
    "conflicts": { "$ref": "#/$defs/dependencies" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "target": { "type": "string", "minLength": 1 },
          "executable": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
        "version": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
      "additionalProperties": { "type": "string" }
    }
  }
}
